# Copy to /etc/dental-clinic/backend.env; configure secrets before starting.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL="jdbc:mysql://DB_PRIVATE_IP:3306/dental_clinic?serverTimezone=UTC"
SPRING_DATASOURCE_USERNAME=dental_app
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
APP_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SPRING_MAIL_USERNAME=REPLACE_ME
SPRING_MAIL_PASSWORD=REPLACE_ME
# Merge existing Razorpay, admin, frontend URL and other application settings here.

# Starting budget for a dedicated backend VM with >= 2 GiB RAM; measure RSS under load.
JAVA_TOOL_OPTIONS="-Xms128m -Xmx768m -XX:+ExitOnOutOfMemoryError"
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
SERVER_TOMCAT_THREADS_MAX=50
APP_MAIL_WORKERS=2
APP_MAIL_QUEUE_CAPACITY=100

GOOGLE_CLIENT_ID=311146912703-id3tm3lbvemt2k10l9qnjl54geiep0ql.apps.googleusercontent.com
